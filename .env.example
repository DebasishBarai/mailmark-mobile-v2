# Copy to .env.local and fill in. These point the app at the SAME backend the
# website uses (its NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).

# Convex deployment URL, e.g. https://happy-animal-123.convex.cloud
EXPO_PUBLIC_CONVEX_URL=

# Clerk publishable key of the website's Clerk instance (pk_live_... / pk_test_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional overrides
# EXPO_PUBLIC_WEB_URL=https://www.mailmark.dev
# EXPO_PUBLIC_API_URL=https://api.mailmark.dev
