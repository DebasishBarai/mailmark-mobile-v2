+++ b/convex/schema.ts
@@ -1141,6 +1141,36 @@ export default defineSchema({
   // redelivered subscription.created re-ran the affiliate commission and paid
   // the referrer a second time. Rows are pruned nightly by
   // subscriptions.pruneWebhookEvents.
+  // ── Mobile app (convex/mobile.ts, convex/pushNotifications.ts) ──
+  // One row per device registered for push. A token moves to whoever
+  // signed in on that device last; sign-out deletes it.
+  pushTokens: defineTable({
