diff --git a/convex/mobile.ts b/convex/mobile.ts
new file mode 100644
index 0000000..f54c63f
--- /dev/null
+++ b/convex/mobile.ts
@@ -0,0 +1,189 @@
+import { v } from "convex/values";
+import { paginationOptsValidator } from "convex/server";
+import { mutation, query } from "./_generated/server";
+import type { QueryCtx } from "./_generated/server";
+import type { Doc } from "./_generated/dataModel";
+
+/**
+ * Functions the Mailmark mobile app needs that the website does not.
+ *
+ * Everything here is additive: no existing function changes shape, and the
+ * website neither calls nor depends on anything in this file. The app asks
+ * `capabilities` once and turns each feature on only when the backend
+ * reports it, so the app also runs against a deployment without this file.
+ */
+
+async function currentUser(ctx: QueryCtx) {
+  const identity = await ctx.auth.getUserIdentity();
+  if (!identity) return null;
+  return await ctx.db
+    .query("users")
+    .withIndex("by_clerk_id", (q) => q.eq("clerkId", identity.subject))
+    .unique();
+}
+
+export const DEFAULT_NOTIFICATION_PREFERENCES = {
+  newMail: true,
+  replies: true,
+  bounces: true,
+  campaigns: true,
+  account: true,
+};
+
+/** What this deployment supports, for the app to feature-detect. */
+export const capabilities = query({
+  args: {},
+  handler: async () => ({
+    version: 1,
+    push: true,
+    campaignRecipients: true,
+  }),
+});
+
+// ── Push tokens ──────────────────────────────────────────────────────────────
+
+/** An Expo push token looks like ExponentPushToken[xxxxxxxx]. */
+const EXPO_TOKEN = /^Expo(nent)?PushToken\[[A-Za-z0-9_-]+\]$/;
+
+/**
+ * Register this device for the signed-in user. A token belongs to one
+ * device, and a device to whoever signed in last, so an existing row for the
+ * token is moved to the current user rather than duplicated. That also means
+ * a phone handed to someone else stops receiving the previous owner's mail.
+ */
+export const registerPushToken = mutation({
+  args: {
+    token: v.string(),
+    platform: v.union(v.literal("ios"), v.literal("android")),
+    deviceName: v.optional(v.string()),
+  },
+  handler: async (ctx, { token, platform, deviceName }) => {
+    const user = await currentUser(ctx);
+    if (!user) throw new Error("Not authenticated");
+    if (!EXPO_TOKEN.test(token)) throw new Error("Invalid push token");
+
+    const existing = await ctx.db
+      .query("pushTokens")
+      .withIndex("by_token", (q) => q.eq("token", token))
+      .unique();
+    const now = Date.now();
+    if (existing) {
+      await ctx.db.patch(existing._id, {
+        userId: user._id,
+        platform,
+        deviceName: deviceName?.slice(0, 80),
+        updatedAt: now,
+      });
+      return null;
+    }
+    await ctx.db.insert("pushTokens", {
+      userId: user._id,
+      token,
+      platform,
+      deviceName: deviceName?.slice(0, 80),
+      createdAt: now,
+      updatedAt: now,
+    });
+    return null;
+  },
+});
+
+/** Called on sign-out. Idempotent. */
+export const unregisterPushToken = mutation({
+  args: { token: v.string() },
+  handler: async (ctx, { token }) => {
+    const user = await currentUser(ctx);
+    if (!user) return null;
+    const existing = await ctx.db
+      .query("pushTokens")
+      .withIndex("by_token", (q) => q.eq("token", token))
+      .unique();
+    if (existing && existing.userId === user._id) await ctx.db.delete(existing._id);
+    return null;
+  },
+});
+
+// ── Notification preferences ────────────────────────────────────────────────
+
+export const getNotificationPreferences = query({
+  args: {},
+  handler: async (ctx) => {
+    const user = await currentUser(ctx);
+    if (!user) return null;
+    const row = await ctx.db
+      .query("notificationPreferences")
+      .withIndex("by_user_id", (q) => q.eq("userId", user._id))
+      .unique();
+    return {
+      newMail: row?.newMail ?? DEFAULT_NOTIFICATION_PREFERENCES.newMail,
+      replies: row?.replies ?? DEFAULT_NOTIFICATION_PREFERENCES.replies,
+      bounces: row?.bounces ?? DEFAULT_NOTIFICATION_PREFERENCES.bounces,
+      campaigns: row?.campaigns ?? DEFAULT_NOTIFICATION_PREFERENCES.campaigns,
+      account: row?.account ?? DEFAULT_NOTIFICATION_PREFERENCES.account,
+    };
+  },
+});
+
+export const setNotificationPreferences = mutation({
+  args: {
+    newMail: v.optional(v.boolean()),
+    replies: v.optional(v.boolean()),
+    bounces: v.optional(v.boolean()),
+    campaigns: v.optional(v.boolean()),
+    account: v.optional(v.boolean()),
+  },
+  handler: async (ctx, patch) => {
+    const user = await currentUser(ctx);
+    if (!user) throw new Error("Not authenticated");
+    const row = await ctx.db
+      .query("notificationPreferences")
+      .withIndex("by_user_id", (q) => q.eq("userId", user._id))
+      .unique();
+    if (row) {
+      await ctx.db.patch(row._id, patch);
+    } else {
+      await ctx.db.insert("notificationPreferences", {
+        userId: user._id,
+        ...DEFAULT_NOTIFICATION_PREFERENCES,
+        ...patch,
+      });
+    }
+    return null;
+  },
+});
+
+// ── Campaigns ────────────────────────────────────────────────────────────────
+
+/**
+ * Every message of one campaign, by batchId, a page at a time.
+ *
+ * The website shows a campaign by grouping whatever page of Sent it has
+ * loaded; this reads the campaign itself through the by_batch index, so a
+ * campaign of any size or age is complete on the phone. A batchId is
+ * guessable, so rows are returned only from mailboxes the caller owns.
+ */
+export const campaignRecipients = query({
+  args: { batchId: v.string(), paginationOpts: paginationOptsValidator },
+  handler: async (ctx, { batchId, paginationOpts }) => {
+    const empty = { page: [], isDone: true, continueCursor: "" };
+    const user = await currentUser(ctx);
+    if (!user) return empty;
+
+    const result = await ctx.db
+      .query("emails")
+      .withIndex("by_batch", (q) => q.eq("batchId", batchId))
+      .paginate(paginationOpts);
+
+    const owned = new Map<string, boolean>();
+    const page: Doc<"emails">[] = [];
+    for (const email of result.page) {
+      const key = email.mailboxId as string;
+      if (!owned.has(key)) {
+        const mailbox = await ctx.db.get(email.mailboxId);
+        owned.set(key, !!mailbox && mailbox.userId === user._id);
+      }
+      if (owned.get(key) && (email.folder === "sent" || email.folder === "outbox")) page.push(email);
+    }
+    return { ...result, page };
+  },
+});
diff --git a/convex/pushNotifications.ts b/convex/pushNotifications.ts
new file mode 100644
index 0000000..b267d17
--- /dev/null
+++ b/convex/pushNotifications.ts
@@ -0,0 +1,236 @@
+import { v } from "convex/values";
+import { internalAction, internalMutation, internalQuery } from "./_generated/server";
+import type { ActionCtx } from "./_generated/server";
+import { internal } from "./_generated/api";
+import type { Doc, Id } from "./_generated/dataModel";
+import { DEFAULT_NOTIFICATION_PREFERENCES } from "./mobile";
+
+/**
+ * Push notifications for the mobile app, sent through the Expo push service.
+ *
+ * Callers schedule one of the `notify*` actions with ctx.scheduler.runAfter(0,
+ * ...) from the mutation or http action where the event happens, so a push
+ * never delays or fails the write that caused it. Each action checks the
+ * user's preferences, builds the message, and sends it to every device the
+ * user has registered. Tokens Expo reports as DeviceNotRegistered are removed.
+ *
+ * Optional: set EXPO_ACCESS_TOKEN on the deployment if "enhanced push
+ * security" is enabled for the Expo project.
+ */
+
+type Kind = "newMail" | "replies" | "bounces" | "campaigns" | "account";
+
+type PushMessage = {
+  title: string;
+  body: string;
+  data: Record<string, string>;
+  channelId: "mail" | "campaigns" | "account";
+  categoryId?: "email_message" | "campaign_update";
+  threadId?: string;
+};
+
+const EXPO_PUSH_URL = "https://exp.host/--/api/v2/push/send";
+
+function nameOf(address: string): string {
+  const m = address.match(/^(.+?)\s*<([^>]+)>$/);
+  if (m) return m[1].trim().replace(/^["']|["']$/g, "");
+  return address.replace(/<|>/g, "");
+}
+
+// ── Reads ────────────────────────────────────────────────────────────────────
+
+export const recipientsFor = internalQuery({
+  args: { userId: v.id("users"), kind: v.string() },
+  handler: async (ctx, { userId, kind }) => {
+    const prefs = await ctx.db
+      .query("notificationPreferences")
+      .withIndex("by_user_id", (q) => q.eq("userId", userId))
+      .unique();
+    const key = kind as Kind;
+    const enabled = prefs ? prefs[key] : DEFAULT_NOTIFICATION_PREFERENCES[key];
+    if (!enabled) return [];
+    const tokens = await ctx.db
+      .query("pushTokens")
+      .withIndex("by_user_id", (q) => q.eq("userId", userId))
+      .collect();
+    return tokens.map((t) => t.token);
+  },
+});
+
+export const emailContext = internalQuery({
+  args: { emailId: v.id("emails") },
+  handler: async (ctx, { emailId }) => {
+    const email = await ctx.db.get(emailId);
+    if (!email) return null;
+    const mailbox = await ctx.db.get(email.mailboxId);
+    if (!mailbox) return null;
+    let isReply = false;
+    if (email.inReplyTo) {
+      const original = await ctx.db
+        .query("emails")
+        .withIndex("by_message_id", (q) => q.eq("messageId", email.inReplyTo!.replace(/^<|>$/g, "").split("@")[0]))
+        .first();
+      isReply = !!original && original.mailboxId === email.mailboxId;
+    }
+    return { email, mailbox, isReply };
+  },
+});
+
+// ── Throttle, so a bounce storm on a big campaign is one notification ────────
+
+export const claimThrottle = internalMutation({
+  args: { key: v.string(), windowMs: v.number() },
+  handler: async (ctx, { key, windowMs }) => {
+    const now = Date.now();
+    const row = await ctx.db
+      .query("notificationThrottle")
+      .withIndex("by_key", (q) => q.eq("key", key))
+      .unique();
+    if (row && now - row.lastSentAt < windowMs) return false;
+    if (row) await ctx.db.patch(row._id, { lastSentAt: now });
+    else await ctx.db.insert("notificationThrottle", { key, lastSentAt: now });
+    return true;
+  },
+});
+
+export const removeTokens = internalMutation({
+  args: { tokens: v.array(v.string()) },
+  handler: async (ctx, { tokens }) => {
+    for (const token of tokens) {
+      const row = await ctx.db
+        .query("pushTokens")
+        .withIndex("by_token", (q) => q.eq("token", token))
+        .unique();
+      if (row) await ctx.db.delete(row._id);
+    }
+  },
+});
+
+// ── Sending ──────────────────────────────────────────────────────────────────
+
+async function send(
+  ctx: ActionCtx,
+  userId: Id<"users">,
+  kind: Kind,
+  message: PushMessage
+) {
+  const tokens: string[] = await ctx.runQuery(internal.pushNotifications.recipientsFor, { userId, kind });
+  if (tokens.length === 0) return;
+
+  const headers: Record<string, string> = {
+    Accept: "application/json",
+    "Content-Type": "application/json",
+  };
+  if (process.env.EXPO_ACCESS_TOKEN) headers.Authorization = `Bearer ${process.env.EXPO_ACCESS_TOKEN}`;
+
+  const messages = tokens.map((to) => ({
+    to,
+    title: message.title,
+    body: message.body,
+    data: message.data,
+    sound: "default",
+    channelId: message.channelId,
+    categoryId: message.categoryId,
+    threadId: message.threadId,
+    priority: message.channelId === "mail" ? "high" : "default",
+  }));
+
+  const res = await fetch(EXPO_PUSH_URL, { method: "POST", headers, body: JSON.stringify(messages) });
+  if (!res.ok) {
+    console.error(`Expo push failed: ${res.status} ${await res.text()}`);
+    return;
+  }
+  const json = (await res.json()) as {
+    data?: Array<{ status: string; details?: { error?: string } }>;
+  };
+  const dead = (json.data ?? [])
+    .map((ticket, i) => (ticket.status === "error" && ticket.details?.error === "DeviceNotRegistered" ? tokens[i] : null))
+    .filter((t): t is string => t !== null);
+  if (dead.length) await ctx.runMutation(internal.pushNotifications.removeTokens, { tokens: dead });
+}
+
+/** A message arrived in a mailbox (warmup traffic is never passed here). */
+export const notifyNewEmail = internalAction({
+  args: { emailId: v.id("emails") },
+  handler: async (ctx, { emailId }) => {
+    const info = await ctx.runQuery(internal.pushNotifications.emailContext, { emailId });
+    if (!info || info.email.folder !== "inbox") return;
+    const { email, mailbox, isReply } = info as { email: Doc<"emails">; mailbox: Doc<"mailboxes">; isReply: boolean };
+    await send(ctx, mailbox.userId, isReply ? "replies" : "newMail", {
+      title: isReply ? `Reply from ${nameOf(email.from)}` : nameOf(email.from),
+      body: email.subject || "(no subject)",
+      data: {
+        url: `/email/${email._id}`,
+        type: isReply ? "reply" : "new_mail",
+        emailId: email._id,
+        mailboxId: mailbox._id,
+      },
+      channelId: "mail",
+      categoryId: "email_message",
+      threadId: mailbox._id,
+    });
+  },
+});
+
+/** A sent message bounced, failed or drew a complaint. */
+export const notifyDeliveryProblem = internalAction({
+  args: { emailId: v.id("emails"), status: v.string() },
+  handler: async (ctx, { emailId, status }) => {
+    const info = await ctx.runQuery(internal.pushNotifications.emailContext, { emailId });
+    if (!info) return;
+    const { email, mailbox } = info as { email: Doc<"emails">; mailbox: Doc<"mailboxes"> };
+    const what = status === "complained" ? "was marked as spam" : "bounced";
+
+    if (email.batchId) {
+      const first = await ctx.runMutation(internal.pushNotifications.claimThrottle, {
+        key: `${mailbox.userId}:delivery:${email.batchId}`,
+        windowMs: 60 * 60 * 1000,
+      });
+      if (!first) return;
+      await send(ctx, mailbox.userId, "bounces", {
+        title: "Delivery problems in a campaign",
+        body: `Messages in “${email.subject}” ${what === "bounced" ? "are bouncing" : "were marked as spam"}. Tap to review.`,
+        data: { url: `/campaign/${encodeURIComponent(email.batchId)}`, type: "delivery_issue", batchId: email.batchId },
+        channelId: "campaigns",
+        categoryId: "campaign_update",
+      });
+      return;
+    }
+
+    await send(ctx, mailbox.userId, "bounces", {
+      title: `Your email ${what}`,
+      body: `To ${email.to.join(", ")}: ${email.subject}`,
+      data: { url: `/email/${email._id}`, type: "bounce", emailId: email._id, mailboxId: mailbox._id },
+      channelId: "campaigns",
+    });
+  },
+});
+
+/** The last scheduled message of a campaign has gone out. */
+export const notifyCampaignSent = internalAction({
+  args: { batchId: v.string(), mailboxId: v.id("mailboxes"), subject: v.string(), count: v.number() },
+  handler: async (ctx, { batchId, mailboxId, subject, count }) => {
+    const mailbox: Doc<"mailboxes"> | null = await ctx.runQuery(internal.emails.getMailboxById, { mailboxId });
+    if (!mailbox) return;
+    await send(ctx, mailbox.userId, "campaigns", {
+      title: "Scheduled campaign sent",
+      body: `“${subject}” went out to ${count} recipient${count === 1 ? "" : "s"}.`,
+      data: { url: `/campaign/${encodeURIComponent(batchId)}`, type: "campaign_completed", batchId },
+      channelId: "campaigns",
+      categoryId: "campaign_update",
+    });
+  },
+});
+
+/** A domain finished DNS verification and can send. */
+export const notifyDomainVerified = internalAction({
+  args: { domainId: v.id("domains"), userId: v.id("users"), domain: v.string() },
+  handler: async (ctx, { domainId, userId, domain }) => {
+    await send(ctx, userId, "account", {
+      title: "Domain verified",
+      body: `${domain} is ready to send and receive mail.`,
+      data: { url: `/domain/${domainId}`, type: "account" },
+      channelId: "account",
+    });
+  },
+});
diff --git a/convex/schema.ts b/convex/schema.ts
index c2f4885..ad8582e 100644
